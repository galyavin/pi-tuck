{
  "name": "pi-tuck",
  "version": "1.0.1",
  "description": "Deterministic compaction for Pi: compact summaries that keep the dialogue and the files touched, plus history recall by keyword and by meaning, all local.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "compaction",
    "context",
    "recall",
    "semantic-search"
  ],
  "license": "MIT",
  "author": "Rustem Galyavin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/galyavin/pi-tuck.git"
  },
  "homepage": "https://github.com/galyavin/pi-tuck#readme",
  "bugs": "https://github.com/galyavin/pi-tuck/issues",
  "type": "module",
  "os": [
    "darwin",
    "linux"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "index.ts",
    "src",
    "dist",
    "scripts/eg2-runtime.py",
    "scripts/provision-eg2.py",
    "scripts/semantic-worker.py",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check": "tsc -p tsconfig.tests.json",
    "test": "vitest run --config vitest.config.ts && python3 -I -B test/eg2-runtime.test.py && python3 -I -B test/semantic-worker-close.test.py",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "24.10.1",
    "typebox": "1.3.27",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
