{
  "name": "pi-tuck",
  "version": "1.10.2",
  "description": "Deterministic compaction for Pi with no model call, plus exact recall of earlier history.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "compaction",
    "context",
    "recall",
    "pi-coding-agent",
    "coding-agent",
    "context-window",
    "deterministic"
  ],
  "license": "MIT",
  "author": "Rustem Galyavin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/galyavin/pi-tuck.git"
  },
  "homepage": "https://github.com/galyavin/pi-tuck#readme",
  "bugs": "https://github.com/galyavin/pi-tuck/issues",
  "type": "module",
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "index.ts",
    "src",
    "dist",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "scripts": {
    "check": "tsc -p tsconfig.tests.json",
    "test": "vitest run --config vitest.config.ts",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "timing": "PI_TUCK_TIMING=1 STRESS=1 vitest run --config vitest.config.ts --maxWorkers=1 test/regression-bench.test.ts test/stress/large-session.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.2.0",
    "@earendil-works/pi-coding-agent": ">=1.2.0",
    "@earendil-works/pi-tui": ">=1.2.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@types/node": "24.10.1",
    "typebox": "1.3.27",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
